# ─── SERVER ENVIRONMENT VARIABLES ────────────────────────────────────────────
# Copy this file to .env and fill in your values
# NEVER commit .env to GitHub!

# App Name (shown in API responses)
APP_NAME=RemoteLink

# MongoDB Atlas connection string
# Get this from: https://cloud.mongodb.com → Connect → Drivers
MONGODB_URI=mongodb+srv://admin:YOUR_PASSWORD@cluster0.xxxxx.mongodb.net/remotelink?retryWrites=true&w=majority

# JWT Secret - use a long random string (min 32 chars)
# Generate one at: https://generate-secret.vercel.app/64
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET_STRING_AT_LEAST_64_CHARS

# Port (Railway sets this automatically - don't change)
PORT=3001
